# Spotify
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
# PostgreSQL
POSTGRES_USER=recomendador
POSTGRES_PASSWORD=
POSTGRES_DB=recomendador
DATABASE_URL=postgresql+psycopg://recomendador:SENHA@postgres:5432/recomendador
# Redis / Celery
REDIS_URL=redis://redis:6379/0
# Armazenamento S3 (SeaweedFS)
S3_ACCESS_KEY=recomendador
S3_SECRET_KEY=
S3_ENDPOINT=http://s3:8333
S3_BUCKET=audio
# Modelos e processamento
DEMUCS_MODEL=htdemucs
TORCH_DEVICE=auto
MAX_EXCERPT_SECONDS=30
ESSENTIA_MODELS_DIR=/models
EMBEDDING_MODEL=clap
# Opcional
CYANITE_TOKEN=
LASTFM_API_KEY=
